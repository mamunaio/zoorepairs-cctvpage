---
// Component: Header.astro - Floating Pill Navigation Bar (Aligned with zoorepairs-cctvpage-main theme)
---

<!-- FLOATING PILL NAVBAR -->
<header id="main-header" class="fixed inset-x-0 top-0 z-50 w-full pt-3 sm:pt-4 px-3 sm:px-6 pointer-events-none transition-all duration-300">
  <div class="mx-auto max-w-[1240px] pointer-events-auto">
    
    <!-- Floating Pill Container with Full Light & Dark Theme Support -->
    <div class="rounded-full border border-slate-200/80 dark:border-white/10 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl px-4 sm:px-7 py-2.5 sm:py-3 shadow-md dark:shadow-[0_10px_35px_rgba(0,0,0,0.5)] flex items-center justify-between gap-3 sm:gap-4 transition-colors duration-300">
      
      <!-- Brand Logo -->
      <a href="https://www.zoorepairs.com.au/" class="flex items-center shrink-0 group transition-transform hover:scale-[1.02]" aria-label="Zoo Computer Repairs">
        <img 
          src="/images/zoo-logo.webp" 
          alt="Zoo Computer Repairs" 
          class="h-7 sm:h-8 w-auto object-contain transition-all"
          width="200"
          height="59"
          loading="eager"
        />
      </a>

      <!-- Desktop Navlinks -->
      <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-xs xl:text-sm font-bold text-slate-600 dark:text-slate-300">
        <a href="https://www.zoorepairs.com.au/about-us/" class="transition-colors hover:text-blue-600 dark:hover:text-blue-400 whitespace-nowrap">About Us</a>
        <a href="https://www.zoorepairs.com.au/computer-services/" class="transition-colors hover:text-blue-600 dark:hover:text-blue-400 whitespace-nowrap">Computer Services</a>
        <a href="https://www.zoorepairs.com.au/remote/" class="transition-colors hover:text-blue-600 dark:hover:text-blue-400 whitespace-nowrap">Remote</a>
        <a href="https://www.zoorepairs.com.au/reviews/" class="transition-colors hover:text-blue-600 dark:hover:text-blue-400 whitespace-nowrap">Reviews</a>
        <a href="https://www.zoorepairs.com.au/blog/" class="transition-colors hover:text-blue-600 dark:hover:text-blue-400 whitespace-nowrap">Blog</a>
        <a href="https://www.zoorepairs.com.au/contact/" class="transition-colors hover:text-blue-600 dark:hover:text-blue-400 whitespace-nowrap">Contact</a>
      </nav>

      <!-- Desktop Right Actions: Phone + Quote Button + Theme Toggle -->
      <div class="hidden lg:flex items-center gap-3 xl:gap-4 shrink-0">
        <!-- Phone Link -->
        <a href="tel:+61477319160" class="flex items-center gap-2 text-xs xl:text-[13px] font-bold text-slate-800 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors whitespace-nowrap group">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400 transition-transform group-hover:scale-110" aria-hidden="true">
            <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path>
          </svg>
          <span>0477 319 160</span>
        </a>

        <!-- Primary CTA Quote Button (Brisbane Red/Rose Gradient) -->
        <a 
          href="#quote" 
          class="rounded-full bg-gradient-to-r from-red-500 via-rose-500 to-red-600 hover:from-red-600 hover:via-rose-600 hover:to-red-500 px-5 xl:px-6 py-2.5 text-xs font-black uppercase tracking-wider text-white shadow-lg shadow-red-500/25 hover:shadow-red-500/40 transition-all duration-300 transform hover:-translate-y-0.5 active:scale-95 whitespace-nowrap flex items-center gap-1.5"
        >
          <span>Request a Quote</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>

        <!-- Theme Toggle Switcher -->
        <button 
          type="button" 
          onclick="toggleTheme()" 
          aria-label="Toggle theme mode" 
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:border-blue-400 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 hidden dark:block text-amber-400" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 block dark:hidden text-amber-500" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile / Tablet Actions (< lg) -->
      <div class="flex items-center gap-2 lg:hidden shrink-0">
        <!-- Call Button Icon for Mobile -->
        <a href="tel:+61477319160" class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 dark:border-white/15 bg-slate-100 dark:bg-slate-800 text-blue-600 dark:text-blue-400 hover:border-blue-400" aria-label="Call Zoo Repairs">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
            <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path>
          </svg>
        </a>

        <!-- Mobile Quote Button (small) -->
        <a href="#quote" class="hidden sm:inline-flex rounded-full bg-gradient-to-r from-red-500 via-rose-500 to-red-600 px-3.5 py-1.5 text-xs font-black uppercase tracking-wider text-white shadow-md shadow-red-500/25 whitespace-nowrap">
          Quote
        </a>

        <!-- Theme Toggle Switcher (Mobile) -->
        <button 
          type="button" 
          onclick="toggleTheme()" 
          aria-label="Toggle theme mode" 
          class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:border-blue-400 dark:hover:border-blue-400 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 hidden dark:block text-amber-400" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 block dark:hidden text-amber-500" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <!-- Hamburger / Close Button -->
        <button 
          id="mobile-menu-btn" 
          type="button" 
          onclick="toggleMobileMenu()" 
          class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:border-blue-400 dark:hover:border-blue-400 cursor-pointer transition-colors" 
          aria-label="Toggle menu" 
          aria-expanded="false"
        >
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <path d="M4 6h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 18h16"></path>
          </svg>
          <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 hidden" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Drawer -->
    <div id="mobile-menu" class="hidden lg:hidden mt-2 rounded-3xl border border-slate-200/80 dark:border-white/10 bg-white/95 dark:bg-slate-900/95 backdrop-blur-2xl p-5 shadow-2xl space-y-4 transition-all duration-300">
      <nav class="flex flex-col divide-y divide-slate-100 dark:divide-white/5 text-sm font-bold text-slate-700 dark:text-slate-300">
        <a href="https://www.zoorepairs.com.au/about-us/" onclick="toggleMobileMenu()" class="py-2.5 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">About Us</a>
        <a href="https://www.zoorepairs.com.au/computer-services/" onclick="toggleMobileMenu()" class="py-2.5 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Computer Services</a>
        <a href="https://www.zoorepairs.com.au/remote/" onclick="toggleMobileMenu()" class="py-2.5 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Remote</a>
        <a href="https://www.zoorepairs.com.au/reviews/" onclick="toggleMobileMenu()" class="py-2.5 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Reviews</a>
        <a href="https://www.zoorepairs.com.au/blog/" onclick="toggleMobileMenu()" class="py-2.5 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Blog</a>
        <a href="https://www.zoorepairs.com.au/contact/" onclick="toggleMobileMenu()" class="py-2.5 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Contact</a>
      </nav>

      <div class="pt-2 flex flex-col sm:flex-row gap-2.5">
        <a href="tel:+61477319160" class="flex-1 py-3 px-4 rounded-xl border border-slate-200 dark:border-white/15 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-white font-bold text-xs flex items-center justify-center gap-2 hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400" aria-hidden="true">
            <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path>
          </svg>
          <span>0477 319 160</span>
        </a>
        <a href="#quote" onclick="toggleMobileMenu()" class="flex-1 py-3 px-4 rounded-xl bg-gradient-to-r from-red-500 via-rose-500 to-red-600 hover:from-red-600 hover:via-rose-600 hover:to-red-500 text-white text-center font-black text-xs uppercase tracking-wider transition-colors shadow-lg shadow-red-500/25">
          Request a Quote
        </a>
      </div>
    </div>

  </div>
</header>
